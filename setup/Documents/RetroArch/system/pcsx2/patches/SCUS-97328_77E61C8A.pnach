// Both queue fills ask one visibility test (0x3B7C98) whether to queue a light; a rejected light is never added, so it
// never uses a cap slot. Its "jr ra" at 0x3B7DCC jumps to a stub at 0x495CC0: lw t0,8(a2) (depth) / lui t1,Car / lui
// t2,Track / t3 = 0x3B8000 / sltu t3,ra,t3 (1 when called from the track-light fill at 0x3B7BE4) / movn t1,t2,t3 /
// sltu t0,t1,t0 / jr ra / movn v0,zero,t0. It can only turn a light off, never on.
patch=1,EE,00495CC0,word,8CC80008
patch=1,EE,00495CC4,word,3C094248
patch=1,EE,00495CC8,word,3C0A428C
patch=1,EE,00495CCC,word,3C0B003B
patch=1,EE,00495CD0,word,356B8000
patch=1,EE,00495CD4,word,03EB582B
