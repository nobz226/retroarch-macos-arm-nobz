[Car Light Pair Thinning 25]
description=Car lights farther than 25 units: skips about half of the light pairs, always both lights of a pair. Closer cars keep every light. Sizes unchanged.
author=Generated from disassembly

// The car-light flare call at 0x3B8BA0 goes to a stub at 0x495C80. The decision uses bit 21 of the lamp's car-local
// position x (the byte at +0x4A of the lamp object; the sign is not included), so mirrored left/right lights always
// get the same answer; centre-line lights are always kept. Only has an effect beyond the car cull distance if that is
// larger than this distance.
patch=1,EE,00495C80,word,8CC9000C
patch=1,EE,00495C84,word,9129004A
patch=1,EE,00495C88,word,31290020
patch=1,EE,00495C8C,word,8CC80008
patch=1,EE,00495C90,word,3C0BC1C8
patch=1,EE,00495C94,word,0168502B
patch=1,EE,00495C98,word,000A480A
patch=1,EE,00495C9C,word,3C190049
patch=1,EE,00495CA0,word,37398198
patch=1,EE,00495CA4,word,03E9C80B
patch=1,EE,00495CA8,word,03200008
patch=1,EE,00495CAC,word,00000000
patch=1,EE,003B8BA0,word,0C125720

