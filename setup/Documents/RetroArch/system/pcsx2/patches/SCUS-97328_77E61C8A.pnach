[Track Light Cap 8]
description=At most 8 track lights with a flare per frame (game default 100). Use with a Light Distance Cull section.
author=Generated from disassembly

// The track lights queue fill starts with "slti x, count, 0x64" (0x3B7BA8); the limit becomes 8. Lights are queued in
// the game's list order, so without a distance cull the kept set changes as lights enter and leave the view (flicker).
patch=1,EE,003B7BA8,word,28460008

