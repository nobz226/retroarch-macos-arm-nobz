gametitle=Gran Turismo 4 [SCUS-97328] (U)

// ==================================================================================================
//  QUICK GUIDE - Gran Turismo 4 flare patches
// ==================================================================================================
//
//  1. Do NOT edit this file. Turn patches on and off in this settings file instead:
//       RetroArch/system/pcsx2/gamesettings/SCUS-97328_77E61C8A.ini
//
//  2. In that file, under [Patches], each line "Enable = <name>" turns on one patch.
//     The name must match a [name] below EXACTLY (spaces and capitals included).
//     To turn a patch off, delete its line or put // in front of it.
//
//  3. Pick only ONE line from each row:
//       Halo ............ Halo Off
//       Distance cull ... Light Distance Cull Track <T> Car <C>
//                           T = 40 50 60 70 80 100   C = 30 40 50 60   (T must be C or more)
//       Track light cap . Track Light Cap <N>     N = 8 12 16 24 32
//       Car light cap ... Car Light Cap <N>       N = 8 12 16 24 32
//       Car thinning .... Car Light Pair Thinning 25 / 50 / 100 / Quarter 50
//       Extras .......... Sun Flare Half Size, GT3 Chase Camera (each on its own, combine freely)
//
//  4. Save the settings file and restart the game (patches only load at boot).
//
//  WHAT THE NUMBERS DO
//    Track / Car distance: lights farther away than this are not drawn. Bigger = lights appear
//                          from farther away, but slower.
//    Cap:                  most lights drawn at once. Bigger = slower. Too low = lights flicker;
//                          if they do, raise the cap or lower the distance.
//
//  TESTED SETTINGS (copy these lines under [Patches] to go back to them):
//    Enable = Halo Off
//    Enable = Sun Flare Half Size
//    Enable = GT3 Chase Camera
//    Enable = Car Light Pair Thinning 50
//    Enable = Light Distance Cull Track 60 Car 40
//    Enable = Track Light Cap 12
//    Enable = Car Light Cap 12
//
//  IF SOMETHING GOES WRONG: remove every "Enable =" line under [Patches] and restart.
//  The game then runs exactly as the original.
// ==================================================================================================
//
// Technical: every address and original instruction was checked against the disc's CORE.GT4 (disc 2.00), decompressed
// (offset = address - 0x100000 + 0x134). patch=1 (continuous): CORE is unpacked after boot.

[Halo Off]
description=Each light flare draws its glow only, without the second, larger halo sprite (one pass per flare instead of two). Glow size unchanged.
author=Generated from disassembly

// The flare draw (0x498198) draws the glow, then the halo when s5=1. The halo test becomes a range test with an empty
// range ("lui t1,0x0000"), so s5 stays 0. 0x49822C jumps to the test at 0x495C40, which returns to 0x498240.
patch=1,EE,00495C40,word,44086000
patch=1,EE,00495C44,word,3C09C080
patch=1,EE,00495C48,word,01094021
patch=1,EE,00495C4C,word,3C090000
patch=1,EE,00495C50,word,0109402B
patch=1,EE,00495C54,word,0108A80B
patch=1,EE,00495C58,word,08126090
patch=1,EE,00495C5C,word,00000000
patch=1,EE,0049822C,word,08125710
patch=1,EE,00498230,word,00000000

[Sun Flare Half Size]
description=Draws the sun flare at 50% width and height instead of full size.
author=Generated from disassembly (moved from the old cheats file)

// The sun flare draw call at 0x3B89E0 (jal 0x4985F8) goes to a stub in padding at 0x495580 that multiplies the size
// argument (f12) by 0.5 and then jumps to the sun draw: lui at,0x3F00 / mtc1 at,f1 / j 0x4985F8 / mul.s f12,f12,f1.
patch=1,EE,00495580,word,3C013F00
patch=1,EE,00495584,word,44810800
patch=1,EE,00495588,word,0812617E
patch=1,EE,0049558C,word,46016302
patch=1,EE,003B89E0,word,0C125560

[GT3 Chase Camera]
description=GT3-like camera from GT4 First Preview
author=Silent (moved from the old cheats file)

// Values changed by this cheat are float values represented in hex.
// If you want to customize those parameters, use a float-to-hex converter like this one:
// https://gregstoll.com/~gregstoll/floattohex/

// Default parameters in this cheat correspond to the values from GT4 First Preview,
// but you may freely customize them. For example, if you want to make the camera
// even stiffer (like in GT5/6), increase the damper value.

// Camera damper, default - 120.0
// Higher values make the camera center quicker
patch=1,EE,0069F4C8,word,41F00000 // 30.0
// Camera max angle, default - 15.0
// Higher values make the camera lean further to the sides
patch=1,EE,0069F4D0,word,41200000 // 10.0

[Light Distance Cull Track 40 Car 30]
description=Track lights farther than 40 units and car lights farther than 30 units are never queued or drawn; every light in view within range is. Keeps far lights out of the Track/Car Light Cap slots, so capped lights don't flicker.
author=Generated from disassembly

// Both queue fills ask one visibility test (0x3B7C98) whether to queue a light; a rejected light is never added, so it
// never uses a cap slot. Its "jr ra" at 0x3B7DCC jumps to a stub at 0x495CC0: lw t0,8(a2) (depth) / lui t1,Car / lui
// t2,Track / t3 = 0x3B8000 / sltu t3,ra,t3 (1 when called from the track-light fill at 0x3B7BE4) / movn t1,t2,t3 /
// sltu t0,t1,t0 / jr ra / movn v0,zero,t0. It can only turn a light off, never on.
patch=1,EE,00495CC0,word,8CC80008
patch=1,EE,00495CC4,word,3C0941F0
patch=1,EE,00495CC8,word,3C0A4220
patch=1,EE,00495CCC,word,3C0B003B
patch=1,EE,00495CD0,word,356B8000
patch=1,EE,00495CD4,word,03EB582B
patch=1,EE,00495CD8,word,014B480B
patch=1,EE,00495CDC,word,0128402B
patch=1,EE,00495CE0,word,03E00008
patch=1,EE,00495CE4,word,0008100B
patch=1,EE,003B7DCC,word,08125730

