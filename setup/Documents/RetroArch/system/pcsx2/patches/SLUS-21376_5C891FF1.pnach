gametitle=Black (NTSC-U) [SLUS-21376]

// 45 FPS for Black, built from the SLUS-21376 ELF (CRC 5C891FF1).
//
// Pacing lives in the vblank handler at 0x002B2BA8: after a flip it sets the
// "vblanks since flip" byte (gp-0x717F) to 1 and flips again once that reaches
// the interval byte (gp-0x787C, set to 2 by 0x002B4DD0). Starting the count at 2
// instead flips on the next vblank. A small routine at 0x000FF000 (unused, zero
// memory below the ELF) starts it at 2, 2, 1 in turn, so frames last 1, 1, 2
// vblanks: 3 frames every 4 vblanks, 45 fps. 0x0027F730 sets the game's fixed
// timestep to 1/rate; it is called with 45 instead of 30, so game speed stays right.
// The phase counter is the byte at 0x000FFFF0.

[45 FPS]
author=nobz226 / Claude
description=Paces frames 1, 1, 2 vblanks (45 fps on average) with a 1/45 s timestep, so the game runs at normal speed. Uneven by design (every third frame lasts twice as long). Works from savestates made at 30 or 60 fps. Use instead of 60 FPS, not with it.
// Vblank interval back to 2 where the game sets it (the 60 FPS patch changes these to 1)
patch=1,EE,001C5B10,word,24040002
patch=1,EE,0012508C,word,24040002
// Game timestep 1/45 s where the game sets it (was 30: addiu a0,zero,0x1e / addiu s0,zero,0x1e)
patch=1,EE,00102648,word,2404002D
patch=1,EE,00125078,word,2410002D
// ...and the values themselves, since a savestate skips the code above: 1/45 s and 22 ms
patch=1,EE,2040EBAC,extended,3CB60B61
patch=1,EE,2040EBA8,extended,00000016
// Routine at 0x000FF000 (phase = phase+1 mod 3; interval = 2; start count = phase ? 2 : 1)
patch=1,EE,000FF000,word,3C010010
patch=1,EE,000FF004,word,9022FFF0
patch=1,EE,000FF008,word,24420001
patch=1,EE,000FF00C,word,2C410003
patch=1,EE,000FF010,word,0001100A
patch=1,EE,000FF014,word,3C010010
patch=1,EE,000FF018,word,A022FFF0
patch=1,EE,000FF01C,word,2C410001
patch=1,EE,000FF020,word,24020002
patch=1,EE,000FF024,word,A3828784
patch=1,EE,000FF028,word,00411023
patch=1,EE,000FF02C,word,A3828E81
patch=1,EE,000FF030,word,080ACB08
patch=1,EE,000FF034,word,00000000
// Hook: the handler's "count = 1" store jumps to the routine (lui v1 runs in the delay slot)
patch=1,EE,002B2C18,word,0803FC00
