description=Track lights farther than 105 units and car lights farther than 60 units are never queued or drawn; every light in view within range is. Keeps far lights out of the Track/Car Light Cap slots, so capped lights don't flicker.
author=Generated from disassembly

// Both queue fills ask one visibility test (0x199580) whether to queue a light; a rejected light is never added, so it
// never uses a cap slot. Its "jr ra" at 0x1996AC jumps to a stub at 0x244B14: lw t0,8(a2) (depth) / lui t1,Car / lui
// t2,Track / t3 = 0x199900 / sltu t3,ra,t3 (1 when called from the track-light fill at 0x1994C8) / movn t1,t2,t3 /
// sltu t0,t1,t0 / jr ra / movn v0,zero,t0. It can only turn a light off, never on.
// GT3 has no other free space: the stub sits in the halo-pass block of the flare draw, and 0x244B0C becomes an
// unconditional branch over it, so halos stay off with this section.
patch=1,EE,00244B0C,word,1000000F
patch=1,EE,00244B14,word,8CC80008
patch=1,EE,00244B18,word,3C094270
patch=1,EE,00244B1C,word,3C0A42D2
patch=1,EE,00244B20,word,3C0B0019
