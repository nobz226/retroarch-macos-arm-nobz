gametitle=Gran Turismo 3 A-Spec [SCPS-15009] (J)

// ==================================================================================================
//  QUICK GUIDE - Gran Turismo 3 A-Spec flare patches
// ==================================================================================================
//
//  1. Do NOT edit this file. Turn patches on and off in this settings file instead:
//       RetroArch/system/pcsx2/gamesettings/SCPS-15009_9DE5CF65.ini
//
//  2. In that file, under [Patches], each line "Enable = <name>" turns on one patch.
//     The name must match a [name] below EXACTLY (spaces and capitals included).
//     To turn a patch off, delete its line or put // in front of it.
//
//  3. Pick only ONE line from each row:
//       Halo ............ Halo Off  OR  Halo Off + Sun Flare Half Size
//       Distance cull ... Light Distance Cull Track <T> Car <C>
//                           T = 60 75 90 105 120   C = 40 50 60 80   (T must be C or more)
//       Track light cap . Track Light Cap <N>     N = 8 12 16 24 32
//       Car light cap ... Car Light Cap <N>       N = 8 12 16 24 32
//       Car thinning .... Car Light Pair Thinning 25 / 50 / 100 / Quarter 50
//
//  4. Save the settings file and restart the game (patches only load at boot).
//
//  WHAT THE NUMBERS DO
//    Track / Car distance: lights farther away than this are not drawn. Bigger = lights appear
//                          from farther away, but slower.
//    Cap:                  most lights drawn at once. Bigger = slower. Too low = lights flicker;
//                          if they do, raise the cap or lower the distance.
//
//  TESTED SETTINGS (copy these lines under [Patches] to go back to them):
//    Enable = Halo Off + Sun Flare Half Size
//    Enable = Car Light Pair Thinning 50
//    Enable = Light Distance Cull Track 90 Car 60
//    Enable = Track Light Cap 12
//    Enable = Car Light Cap 12
//
//  IF SOMETHING GOES WRONG: remove every "Enable =" line under [Patches] and restart.
//  The game then runs exactly as the original.
// ==================================================================================================
//
// Technical: every address and original instruction was checked against the disc's CORE.GT3 (disc 1.01), decompressed
// (offset = address - 0x100000 + 0x114). patch=1 (continuous): CORE is unpacked after boot.

[Halo Off]
description=Each light flare draws its glow only, without the second, larger halo sprite (one pass per flare instead of two). Glow size unchanged.
author=Generated from disassembly

// The flare draw (0x244990) draws the glow, then the halo when s5=1. The halo test becomes a range test with an empty
// range ("lui t1,0x0000"), so s5 stays 0. The test at 0x244A24-0x244A38 is rewritten in place.
patch=1,EE,00244A24,word,44080800
patch=1,EE,00244A28,word,3C09C080
patch=1,EE,00244A2C,word,01094021
patch=1,EE,00244A30,word,3C090000
patch=1,EE,00244A34,word,0109402B
patch=1,EE,00244A38,word,0108A80B

[Halo Off + Sun Flare Half Size]
description=Halo Off, plus the sun flare drawn at 50% width and height. Use instead of Halo Off.
author=Generated from disassembly

// The halo test at 0x244A24 becomes "b 0x244A3C" (no halo, as Halo Off), which leaves 0x244A2C-0x244A38 unreachable;
// the sun stub goes there: lui at,0x3F00 / mtc1 at,f1 / j 0x244E00 / mul.s f12,f12,f1. The sun draw call at 0x19A298
// (jal 0x244E00) goes to the stub.
patch=1,EE,00244A24,word,10000005
patch=1,EE,00244A28,word,00000000
patch=1,EE,00244A2C,word,3C013F00
patch=1,EE,00244A30,word,44810800
patch=1,EE,00244A34,word,08091380
patch=1,EE,00244A38,word,46016302
patch=1,EE,0019A298,word,0C09128B

[Light Distance Cull Track 60 Car 40]
description=Track lights farther than 60 units and car lights farther than 40 units are never queued or drawn; every light in view within range is. Keeps far lights out of the Track/Car Light Cap slots, so capped lights don't flicker.
author=Generated from disassembly

// Both queue fills ask one visibility test (0x199580) whether to queue a light; a rejected light is never added, so it
// never uses a cap slot. Its "jr ra" at 0x1996AC jumps to a stub at 0x244B14: lw t0,8(a2) (depth) / lui t1,Car / lui
// t2,Track / t3 = 0x199900 / sltu t3,ra,t3 (1 when called from the track-light fill at 0x1994C8) / movn t1,t2,t3 /
// sltu t0,t1,t0 / jr ra / movn v0,zero,t0. It can only turn a light off, never on.
// GT3 has no other free space: the stub sits in the halo-pass block of the flare draw, and 0x244B0C becomes an
// unconditional branch over it, so halos stay off with this section.
patch=1,EE,00244B0C,word,1000000F
patch=1,EE,00244B14,word,8CC80008
patch=1,EE,00244B18,word,3C094220
patch=1,EE,00244B1C,word,3C0A4270
patch=1,EE,00244B20,word,3C0B0019
patch=1,EE,00244B24,word,356B9900
patch=1,EE,00244B28,word,03EB582B
patch=1,EE,00244B2C,word,014B480B
patch=1,EE,00244B30,word,0128402B
patch=1,EE,00244B34,word,03E00008
patch=1,EE,00244B38,word,0008100B
patch=1,EE,001996AC,word,080912C5

[Light Distance Cull Track 75 Car 40]
description=Track lights farther than 75 units and car lights farther than 40 units are never queued or drawn; every light in view within range is. Keeps far lights out of the Track/Car Light Cap slots, so capped lights don't flicker.
